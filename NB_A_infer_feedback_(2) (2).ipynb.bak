      "source": [
        "# NB-A — Gradio inference + optional feedback + ClearML dataset versioning (every 5)\n",
        "\n",
        "import os, io, json, time, uuid, traceback\n",
        "from pathlib import Path\n",
        "from typing import Tuple\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "from torchvision import transforms, models\n",
        "from PIL import Image\n",
        "\n",
        "import gradio as gr\n",
        "from clearml import Model, Dataset\n",
        "\n",
        "# -------------------- CONFIG --------------------\n",
        "PROJECT = \"Image-Classifier/Gradio-Retrain-Demo-IABD\"\n",
        "DATASET_NAME = \"image-feedback\"\n",
        "# Use a writable local directory instead of /content, which is only valid in Colab.\n",
        "BASE_DIR = Path.home() / \"clearml_feedback\"\n",
        "FEEDBACK_DIR = BASE_DIR / \"feedback\"\n",
        "STATE_FILE = BASE_DIR / \"state.json\"    # to count stored samples\n",
        "BASE_DIR.mkdir(parents=True, exist_ok=True)\n",
        "FEEDBACK_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# -------------------- MODEL LOADING --------------------\n",
        "def build_resnet18(num_classes=10):\n",
        "    m = models.resnet18(weights=None)\n",
        "    m.fc = nn.Linear(m.fc.in_features, num_classes)\n",
        "    return m\n",
        "\n",
        "CLASSES = [\n",
        "    \"airplane\",\"automobile\",\"bird\",\"cat\",\"deer\",\n",
        "    \"dog\",\"frog\",\"horse\",\"ship\",\"truck\"\n",
        "]\n",
        "\n",
        "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "\n",
        "def load_production_model() -> nn.Module:\n",
        "    \"\"\"Load last published model tagged 'production'; fallback to random init.\"\"\"\n",
        "    try:\n",
        "        prods = Model.query_models(project_name=PROJECT, tags=[\"candidate\"], only_published=True) or []\n",
        "        if not prods:\n",
        "            print(\"⚠️ No PRODUCTION model found; using randomly initialized ResNet18.\")\n",
        "            m = build_resnet18(10).to(DEVICE); m.eval(); return m\n",
        "        prod = prods[0]\n",
        "        local = prod.get_local_copy()\n",
        "        print(\"✅ Loaded production model:\", prod.id, \"from\", local)\n",
        "        m = build_resnet18(10).to(DEVICE)\n",
        "        sd = torch.load(local, map_location=DEVICE)\n",
        "        m.load_state_dict(sd, strict=False)\n",
        "        m.eval()\n",
        "        return m\n",
        "    except Exception:\n",
        "        print(\"⚠️ Failed to load production model, using random init:\\n\", traceback.format_exc())\n",
        "        m = build_resnet18(10).to(DEVICE); m.eval(); return m\n",
        "\n",
        "model = load_production_model()\n",
        "\n",
        "# -------------------- PREPROCESS --------------------\n",
        "TFM = transforms.Compose([\n",
        "    transforms.Resize((32,32)),\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225]),\n",
        "])\n",
        "\n",
        "@torch.no_grad()\n",
        "def predict_image(pil: Image.Image) -> Tuple[str, float]:\n",
        "    pil = pil.convert(\"RGB\")\n",
        "    x = TFM(pil).unsqueeze(0).to(DEVICE)  # [1,3,32,32]\n",
        "    logits = model(x)\n",
        "    prob = torch.softmax(logits, dim=1)[0]\n",
        "    conf, idx = torch.max(prob, dim=0)\n",
        "    return CLASSES[int(idx)], float(conf.item())\n",
        "\n",
        "# -------------------- FEEDBACK STORE --------------------\n",
        "def _load_state():\n",
        "    try:\n",
        "        if STATE_FILE.exists():\n",
        "            return json.loads(STATE_FILE.read_text())\n",
        "    except Exception:\n",
        "        print(\"⚠️ state load failed:\", traceback.format_exc())\n",
        "    return {\"stored\": 0, \"last_version_id\": None}\n",
        "\n",
        "def _save_state(stored: int, last_version_id: str | None):\n",
        "    try:\n",
        "        STATE_FILE.write_text(json.dumps({\"stored\": stored, \"last_version_id\": last_version_id}))\n",
        "    except Exception:\n",
        "        print(\"⚠️ state save failed:\", traceback.format_exc())\n",
        "\n",
        "def store_feedback(pil: Image.Image, true_label: str | None) -> str:\n",
        "    \"\"\"\n",
        "    Save to <home>/clearml_feedback/feedback/<label>/<uuid>.png\n",
        "    If no true_label provided -> save under 'unlabeled'\n",
        "    \"\"\"\n",
        "    try:\n",
        "        pil = pil.convert(\"RGB\")\n",
        "        label = true_label.strip() if (true_label and str(true_label).strip()) else \"unlabeled\"\n",
        "        dest_dir = FEEDBACK_DIR / label\n",
        "        dest_dir.mkdir(parents=True, exist_ok=True)\n",
        "        fname = f\"{uuid.uuid4().hex}.png\"\n",
        "        path = dest_dir / fname\n",
        "        pil.save(path, format=\"PNG\")\n",
        "        return str(path)\n",
        "    except Exception as e:\n",
        "        print(\"❌ store_feedback error:\\n\", traceback.format_exc())\n",
        "        raise e\n",
        "\n",
        "def version_dataset_if_needed() -> tuple[bool, str]:\n",
        "    \"\"\"\n",
        "    Every 5 new samples → create a new ClearML Dataset version (image-feedback), robust to draft parents.\n",
        "    Returns (did_version, dataset_id_or_msg)\n",
        "    \"\"\"\n",
        "    st = _load_state()\n",
        "    st[\"stored\"] += 1\n",
        "    did = False\n",
        "    dsid = st.get(\"last_version_id\")\n",
        "\n",
        "    if st[\"stored\"] >= 5:\n",
        "        try:\n",
        "            parent_id = None\n",
        "            parent_ds = None\n",
        "            # Try to get parent (latest ‘image-feedback’ in this project)\n",
        "            try:\n",
        "                parent_ds = Dataset.get(dataset_name=DATASET_NAME, dataset_project=PROJECT)\n",
        "                parent_id = parent_ds.id\n",
        "            except Exception:\n",
        "                parent_ds, parent_id = None, None\n",
        "\n",
        "            # If parent exists but might be draft, try finalize (best-effort)\n",
        "            if parent_ds is not None:\n",
        "                try:\n",
        "                    parent_ds.finalize()\n",
        "                except Exception:\n",
        "                    pass  # ok if already final or cannot finalize\n",
        "\n",
        "            # Try create with parent; if it fails (draft parent), create without parent\n",
        "            try:\n",
        "                new = Dataset.create(\n",
        "                    dataset_name=DATASET_NAME,\n",
        "                    dataset_project=PROJECT,\n",
        "                    parent_datasets=[parent_id] if parent_id else None,\n",
        "                )\n",
        "            except Exception as e:\n",
        "                print(\"⚠️ create with parent failed, fallback root:\", e)\n",
        "                new = Dataset.create(dataset_name=DATASET_NAME, dataset_project=PROJECT)\n",
        "\n",
        "            new.add_files(str(FEEDBACK_DIR))\n",
        "            try:\n",
        "                new.upload()\n",
        "            except Exception as e:\n",
        "                print(\"upload warning:\", e)\n",
        "\n",
        "            new.finalize()\n",
        "            dsid = new.id\n",
        "            did = True\n",
        "            st[\"stored\"] = 0  # reset counter after versioning\n",
        "            st[\"last_version_id\"] = dsid\n",
        "            print(f\"✅ Created & finalized dataset version: {dsid}\")\n",
        "        except Exception:\n",
        "            print(\"❌ dataset versioning failed:\\n\", traceback.format_exc())\n",
        "            # keep counter as is (so we can retry next time)\n",
        "\n",
        "    _save_state(st[\"stored\"], dsid)\n",
        "    return did, dsid or \"\"\n",
        "\n",
        "# -------------------- GRADIO UI --------------------\n",
        "def predict_and_store(image: Image.Image, store: bool, true_label: str) -> tuple[str, float, str]:\n",
        "    \"\"\"\n",
        "    Returns: (pred_label, confidence, status_text)\n",
        "    \"\"\"\n",
        "    try:\n",
        "        pred, conf = predict_image(image)\n",
        "        status = f\"Pred: {pred} ({conf:.3f})\"\n",
        "        if store:\n",
        "            path = store_feedback(image, true_label)\n",
        "            did, dsid = version_dataset_if_needed()\n",
        "            if did:\n",
        "                status += f\" | ✅ Pushed new dataset version: {dsid}\"\n",
        "            else:\n",
        "                st = _load_state()\n",
        "                need = 5 - st[\"stored\"]\n",
        "                status += f\" | saved to {path} (need {need} more to version)\"\n",
        "        return pred, conf, status\n",
        "    except Exception as e:\n",
        "        print(\"❌ predict_and_store exception:\\n\", traceback.format_exc())\n",
        "        return \"error\", 0.0, f\"ERROR: {e}\"\n",
        "\n",
        "with gr.Blocks(title=\"ResNet18 CIFAR-10 – Predict & (optional) Store\") as demo:\n",
        "    gr.Markdown(\"### Upload an image (CIFAR-10-like), then **Predict**. Optionally **Store** with a true label to collect feedback.\")\n",
        "    with gr.Row():\n",
        "        in_img = gr.Image(type=\"pil\", label=\"Input image\")\n",
        "        with gr.Column():\n",
        "            do_store   = gr.Checkbox(label=\"Store feedback\", value=False)\n",
        "            true_label = gr.Dropdown(choices=CLASSES + [\"unlabeled\"], value=\"unlabeled\", label=\"True label (if storing)\")\n",
        "            btn        = gr.Button(\"Predict (and Store if checked)\")\n",
        "    with gr.Row():\n",
        "        out_label = gr.Textbox(label=\"Predicted label\")\n",
        "        out_conf  = gr.Number(label=\"Confidence\", precision=4)\n",
        "    out_status = gr.Textbox(label=\"Status\")\n",
        "\n",
        "    btn.click(predict_and_store, inputs=[in_img, do_store, true_label], outputs=[out_label, out_conf, out_status])\n",
        "\n",
        "\n",
        "demo.launch(share=False)  # set share=True if you need a public link"
      ]
    }
  ],
